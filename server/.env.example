# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aipk?retryWrites=true&w=majority

# Session cookie signing secret — any long random string
SESSION_SECRET=change-me-to-a-long-random-string

# Google Gemini API key (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model id. Flash models sit on the more generous free-tier RPM/TPM.
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated origins allowed to call this API with credentials
# (your deployed Vercel frontend URL, and http://localhost:3000 for dev)
CLIENT_ORIGINS=http://localhost:3000

# Security (Section 11): reject private/loopback IPs when fetching external
# URLs. Must stay "false" in production. The batch entry point (Section 9)
# is tested against company sites served from localhost, so this needs to
# be "true" when running `npm run evaluate` locally/in CI, and is read
# separately from NODE_ENV so a real deployment can't accidentally allow it.
ALLOW_PRIVATE_HOSTS=false

# Google Programmable Search Engine (https://programmablesearchengine.google.com/)
# free tier (100 queries/day) — used to look for public discussion of a
# company's interview process. Optional: if left blank, discussion search
# is skipped and reported honestly rather than failing the run.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
